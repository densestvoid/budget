# DigitalOcean Configuration
do_token = "your-digitalocean-api-token-here"

# Infrastructure Configuration
region = "nyc1"

# GitHub Integration
# Note: github_repo is auto-detected from GITHUB_REPOSITORY environment variable
docker_image_tag = "production-latest"

# Optional custom domain (App Platform + DO DNS zone manage records automatically)
# domain_name = "budget.example.com"
# dns_zone = "example.com"
